# --- Django ---
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_ADMIN_URL=admin/
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Data ---
DATABASE_URL=postgres://shazlo:shazlo@localhost:5432/shazlo
REDIS_STATE_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6379/1

# --- Auth ---
JWT_SIGNING_KEY=dev-insecure-change-me
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
GOOGLE_OAUTH_CLIENT_IDS=

# --- Storage (MinIO locally, R2 in prod) ---
USE_R2=false
R2_ENDPOINT_URL=http://localhost:9000
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET=shazlo
R2_PUBLIC_BASE_URL=http://localhost:9000/shazlo

# --- Integrations (all off by default) ---
USE_PINECONE=false
PINECONE_API_KEY=pclocal
PINECONE_INDEX=shazlo-local
PINECONE_HOST=http://localhost:5080
USE_MODAL=false
MODAL_EMBED_URL=
MODAL_TOKEN=
USE_RAZORPAY=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
USE_WHATSAPP=false
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
CORS_ALLOWED_ORIGINS=

# --- Observability ---
OTEL_ENABLED=false
OTEL_SAMPLE_RATIO=1.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# prod collector only:
OTEL_BACKEND_ENDPOINT=
OTEL_BACKEND_AUTH=

# --- Prod compose only ---
DOMAIN=api.shazlo.store
